* {
    rosewater: #f5e0dc;
    flamingo: #f2cdcd;
    pink: #f5c2e7;
    mauve: #cba6f7;
    red: #f38ba8;
    maroon: #eba0ac;
    peach: #fab387;
    yellow: #f9e2af;
    green: #a6e3a1;
    teal: #94e2d5;
    sky: #89dceb;
    sapphire: #74c7ec;
    blue: #89b4fa;
    lavender: #b4befe;
    text: #cdd6f4;
    subtext1: #bac2de;
    subtext0: #a6adc8;
    overlay2: #9399b2;
    overlay1: #7f849c;
    overlay0: #6c7086;
    surface2: #585b70;
    surface1: #45475a;
    surface0: #313244;
    base: #1e1e2e;
    mantle: #181825;
    crust: #11111b;
    background-color: transparent;
    text-color: @text;
    accent: @mauve;
    font: "JetBrainsMono Nerd Font Propo 11";
}
window {
    background-color: @base;
    border: 2px;
    border-color: @accent;
    border-radius: 16px;
    width: 600px;
    location: center;
    anchor: center;
    padding: 0;
}
mainbox {
    background-color: transparent;
    padding: 18px;
    children: [ "inputbar", "listview" ];
    spacing: 14px;
}
inputbar {
    background-color: @surface0;
    border-radius: 12px;
    padding: 10px 14px;
    spacing: 10px;
    children: [ "prompt", "entry" ];
}
prompt {
    background-color: transparent;
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Propo 11";
}
entry {
    background-color: transparent;
    text-color: @text;
    placeholder: "Search...";
    placeholder-color: @overlay0;
}
listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    spacing: 4px;
    cycle: true;
    dynamic: true;
    layout: vertical;
}
element {
    background-color: transparent;
    text-color: @text;
    border-radius: 10px;
    padding: 8px 10px;
    spacing: 10px;
}
element selected {
    background-color: @accent;
    text-color: @base;
}
element-icon {
    size: 24px;
    horizontal-align: 0.5;
}
element-text {
    vertical-align: 0.5;
    text-color: inherit;
}
